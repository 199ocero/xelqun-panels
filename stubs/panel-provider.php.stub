<?php

namespace {{ namespace }};

use Xelqun\Panels\Pages\Dashboard;
use Xelqun\Panels\Panel;
use Xelqun\Panels\PanelProvider;

class {{ class }} extends PanelProvider
{
    public function panel(Panel $panel): Panel
    {
        return $panel
            ->id('{{ id }}')
            ->path('{{ id }}')
            ->login()
            ->pages([Dashboard::class]);
    }
}
