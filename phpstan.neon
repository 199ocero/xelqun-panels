includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src/
        - tests/TestCase.php

    level: 6
    ignoreErrors:
        # Traits here are for an app's models, so nothing in this package uses them.
        - identifier: trait.unused
        # Fortify's trait, which it checks the user has with class_uses_recursive() first.
        - identifier: method.notFound
          path: src/Auth/FortifyTwoFactor.php
        - identifier: property.notFound
          path: src/Auth/FortifyTwoFactor.php
